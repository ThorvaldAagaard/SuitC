#!/bin/bash

PGM=${0##*/}

USAGE() {
    print "\
NAME
    ${PGM} - delete 100 percent resultsunless it are safety plays

SYNOPSIS
    ${PGM} [infile]

DESCRIPTION
    ${PGM} deletes 100 percent unless it are safety plays

PARAMETERS
    infile     the input file

AUTHOR
    G.A. van der Velde, Leiden
" 1>&2
    exit 22
}

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-*|\? )  USAGE;;
	*)       USAGE;;
    esac
    shift
done

sed '
    s/N[0-9]*([0-9]*):100.0000           //g
' $fil
