#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - analyse all suit combinations

SYNOPSIS
    ${PGM}

DESCRIPTION
    ${PGM} analyses all suit combinations. this script should be run
    after /home/gerrit/bridge/Backups/suit-combinations.Rev4.20260217.tgz
    has been untarred.

PARAMETERS
    none

AUTHOR
    G.A. van der Velde, Leiden
" 1>&2
    exit 22
}

# check the parameter
[[ $1 ]] || USAGE

for m in $1
do
    (
	cd $m
	[[ -a plays ]] || mkdir plays
	rm -f plays/*
	P-run $m > res
	sc-norm res > $m.res
	cat $m.res | P-all > $m.all
    )
done
