#!/usr/bin/perl

#       P-run runs all analysis commands that are contained in the input file.
#       The script contains logic to determine which sequences of small cards give
#       identical results in order to reduce the number of analysis that are executed.
#
#       Calling sequence:
#
#               P-run <infile>
#
#       <infile>        the script file that is generated by the sc-install command

# initialize
$N = 0;
$cards = "AKQJT98765432";
@cards = qw( A K Q J T 9 8 7 6 5 4 3 2 );

# read the input file
while ( <> ) {
    @F = split /\s+/, $_;
    if ( /^SuitC/ ) {
        # skip the options on the SuitC command line
        for ( $i = 1; ; $i++ ) { last if $F[$i] !~ /-/; }
        $no[$N] = $F[$i+0];
        $so[$N] = $F[$i+1];
        $ew[$N] = $F[$i+2];
        $rank{$no[$N],$so[$N],$ew[$N]} = $N;
    }
    $line[$N++] = $_;
}

# set the number of cards in each hand
$nce = length $ew[0];
$ncn = length $no[0];
$ncs = length $so[0];
if ( $no[0] =~ /'/ ) { $ncn--; }
if ( $so[0] =~ /'/ ) { $ncs--; }

# main loop over all suit combinations
for ( $bot = 0; $bot < $N; $bot++ ) {
    print "$line[$bot]" if $line[$bot] !~ /SuitC/;
    next if $line[$bot] !~ /SuitC/;
    `sc-check "$line[$bot]"`;
    $line[$bot] = `P-resultm out`;
    `rm -f out`;
    $m = index($line[$bot],"M");
    $res = substr($line[$bot],$m);
    print "$line[$bot]";

    # count the low cards in each hand
    $n2 = 12;
    for ( $n1 = $n2; $n1 >= 0; $n1-- ) { last if $no[$bot] !~ $cards[$n1]; }
    $n1++;
    $s2 = $n1-1;
    for ( $s1 = $s2; $s1 >= 0; $s1-- ) { last if $so[$bot] !~ $cards[$s1]; }
    $s1++;
    $e2 = $s1-1;
    for ( $e1 = $e2; $e1 >= 0; $e1-- ) { last if $ew[$bot] !~ $cards[$e1]; }
    $e1++;

    # extract the high cards in each hand
    $hno = $no[$bot];
    if ( $n1 <= $n2 ) {
        $c = substr($cards,$n1,$n2-$n1+1);
        $hno =~ s/$c//;
    }
    $hso = $so[$bot];
    if ( $s1 <= $s2 ) {
        $c = substr($cards,$s1,$s2-$s1+1);
        $hso =~ s/$c//;
    }
    $hew = $ew[$bot];
    if ( $e1 <= $e2 ) {
        $c = substr($cards,$e1,$e2-$e1+1);
        $hew =~ s/$c//;
    }

    # loop over the suit comninations
    for ( ; ; ) {
        # extract the cards that can be freely distributed
        $c = $cards;
        for ( $i = 0; $i < 13; $i++ ) {
            if ( $hno =~ /$cards[$i]/ ) { $c =~ s/$cards[$i]//; }
            if ( $hso =~ /$cards[$i]/ ) { $c =~ s/$cards[$i]//; }
            if ( $hew =~ /$cards[$i]/ ) { $c =~ s/$cards[$i]//; }
        }
        if ( $hno !~ /\./ ) { $c =~ s/$hno//; }
        if ( $s1 <= $s2 ) { $c =~ s/$hso//; }
        if ( $e1 <= $e2 ) { $c =~ s/$hew//; }
        $s = $hso;
        if ( $s1 <= $s2 ) { $s .= substr($c,0,$s2-$s1+1); }
        $n = $hno;
        if ( $n1 <= $n2 ) { $n .= substr($c,$s2-$s1+1,$n2-$n1+1); }
        $e = $hew;
        if ( $e1 <= $e2 ) { $e .= substr($c,$s2+$n2-$s1-$n1+2,$e2-$e1+1); }

        # reorder the cards between north and south
        order();
        $ix = $rank{$n,$s,$e};
        if ( $line[$ix] =~ /SuitC/ ) {
            `sc-check "$line[$ix]"`;
            $line[$ix] = `P-resultm out`;
            `rm -f out`;
        }

        # adjust the high cards in EW if the results differ
        if ( $res ne substr($line[$ix],$m) ) {
            $v = substr($c,0,1);
            $hew .= $v;
            $c =~ s/$v//;
        }

        # result is the same as the bottom one and all the ones in between
        # generate first all suit combinations
        else {
            $l0 = 0;
            $l1 = 1;
            $len = length $c;
            $nstk[$l0] = $hno;
            $sstk[$l0] = $hso;
            $estk[$l0] = $hew;
            for ( $i = 0; $i < $len; $i++ ) {
                $v = substr($c,$i,1);
                $l2 = $l1;
                for ( $l = $l0; $l < $l1; $l++ ) {
                    $ln = length $nstk[$l];
                    $ls = length $sstk[$l];
                    $le = length $estk[$l];
                    if ( $ln < $ncn ) { $nstk[$l2] = "$nstk[$l]$v"; $sstk[$l2] = $sstk[$l]; $estk[$l2] = $estk[$l]; $l2++; }
                    if ( $ls < $ncs ) { $sstk[$l2] = "$sstk[$l]$v"; $estk[$l2] = $estk[$l]; $nstk[$l2] = $nstk[$l]; $l2++; }
                    if ( $le < $nce ) { $estk[$l2] = "$estk[$l]$v"; $nstk[$l2] = $nstk[$l]; $sstk[$l2] = $sstk[$l]; $l2++; }
                }
                $l0 = $l1;
                $l1 = $l2;
            }

            # copy the results;
            for ( $l = $l0; $l < $l1; $l++ ) {
                $n = $nstk[$l];
                $s = $sstk[$l];
                $e = $estk[$l];
                order();
                $ix = $rank{$n,$s,$e};
                $line[$ix] = "N: $n   S: $s   EW: $e   $res";
            }
            last;
        }
    }
}

sub order {
    for ( $i = 11; $i >= 0; $i-- ) {
        if ( $n =~ /$cards[$i]/ && $s =~ /$cards[$i+1]/ ) {
            for ( $j = $i; $j <= 12; $j++ ) {
                if ( $n =~ /$cards[$j]/ && $s =~ /$cards[$j+1]/ ) {
                    substr($n,index($n,$cards[$j]),1) = $cards[$j+1];
                    substr($s,index($s,$cards[$j+1]),1) = $cards[$j];
                }
                else { last; }
            }
        }
    }
    return( $n, $s );
}
