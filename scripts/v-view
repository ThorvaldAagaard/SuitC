#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "\
NAME
    ${PGM} - report selected information from the SuitC output

SYNOPSIS
    ${PGM} [-h<highc>] [-n<north>] [-s<south>] [-c<count>] [-d<dirs>] [file]

DESCRIPTION
    ${PGM} reports selected information from the SuitC output. The
    selected output consists of:
    i)       the distribution
    ii)      the optimum play for N? and MAX
    iii)     the optimum results
    the boards are printed only if the game tree is printed

PARAMETERS
    -a           print all plays
    -b           print the east-west distributions
    -p           print the game tree
    -h<highc>    the combined holding in high cards in north and south
    -n<north>    the holding in high cards in north
    -s<south>    the holding in high cards in south
    -c<count>    the number of cards in the north and south hand combined
    -d<dirs>     the distribution in the north-south hands, e.g. 34, 52 or 55
    infile       the input files. this file is an output file of script v-equals

AUTHOR
    G.A. van der Velde, Leiden
" 1>&2
    exit 1
}

# set defaults
highc='[0-9TJQKA]*'
north='[0-9TJQKA]*'
south='[0-9TJQKA]*'
count=.
dirs=..
fil=
x='[^0-9TJQKA]*'

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-a)      all="-a";;
	-b)      boards="-b";;
	-p)      plays="-p";;
	-h)      highc=$2; shift;;
	-h*)     highc=${1#-h};;
	-n)      north=$2; shift;;
	-n*)     north=${1#-n};;
	-s)      south=$2; shift;;
	-s*)     south=${1#-s};;
	-c)      count=$2; shift;;
	-c*)     count=${1#-c};;
	-d)      dirs=$2; shift;;
	-d*)     dirs=${1#-d};;
	-*|\? )  USAGE;;
	*)       fil="$fil $1";;
    esac
    shift
done

grep "^$highc$x	$north$x	$south$x	...	$count	$dirs" $fil | v-list $all $boards $plays | bash
