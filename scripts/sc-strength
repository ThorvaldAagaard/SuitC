#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - calculate the expected playing strength for all distributions

SYNOPSIS
    ${PGM} [-mn <mn>] [-ms <ms>] [-nn <nn>] [-ns <ns>] [-r] [-o <out>] infile

DESCRIPTION
    ${PGM} calculate the expected playing strength for all distributions

PARAMETERS
    -mn            regular expression that should be matched by north
    -ms            regular expression that should be matched by south
    -nn            regular expression that should not be matched by north
    -ns            regular expression that should not be matched by south
    -r             report=0 (default!) print only distributions that score better than all weaker ones
    -o             the output files
    infile         the input file

AUTHOR
    G.A. van der Velde
" 1>&2
    exit 22
}

# set defaults
mn="[-23456789TJQKA]"
ms="[-23456789TJQKA]"
nn="0"
ns="0"
rprt=
in=""
out="$(pwd)"
out="${out##*/}"

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-mn)     mn=$2; shift;;
	-ms)     ms=$2; shift;;
	-nn)     nn=$2; shift;;
	-ns)     ns=$2; shift;;
	-r)      rprt=1;;
	-o)      out="$2"; shift;;
	-mn*)    mn=${1#-mn};;
	-ms*)    ms=${1#-ms};;
	-nn*)    nn=${1#-nn};;
	-ns*)    ns=${1#-ns};;
	-o*)     out="${1#-o}";;
	-*|\? )  USAGE;;
	*)       in="$1";;
    esac
    shift
done

# calculate the playing strength
awk '
{
    if ( $2 ~ mn && $2 !~ nn && $4 ~ ms && $4 !~ ns ) {
	north[$2] = $2
	south[$4] = $4
	no[$2,0]++
	so[$4,0]++
	no[$2,1] = $1
	no[$2,2] = $2
	so[$4,1] = $3
	so[$4,2] = $4
	for ( i = 8; i <= NF; i += 2 )
	{
	    no[$2,i-5]  = $(i-1)
	    no[$2,i-4] += $i
	    so[$4,i-5]  = $(i-1)
	    so[$4,i-4] += $i
	}
    }
}
END {
    for ( m in north ) {
	printf "%s %s   %s %7.4f", no[m,1], no[m,2], no[m,3], no[m,4] / no[m,0] > ".no"
	for ( i = 5; i < NF-4; i += 2 )
	    printf "   %s %8.4f", no[m,i], no[m,i+1] / no[m,0] > ".no"
	printf "\n"> ".no"
    }
    for ( m in south ) {
	printf "%s %s   %s %7.4f", so[m,1], so[m,2], so[m,3], so[m,4] / so[m,0] > ".so"
	for ( i = 5; i < NF-4; i += 2 )
	    printf "   %s %8.4f", so[m,i], so[m,i+1] / so[m,0] > ".so"
	printf "\n"> ".so"
    }
}
' mn=$mn ms=$ms nn=$nn ns=$ns $in

# order the output
for m in no so
do
    [[ -f .$m ]] &&
    {
	sed '
	    s/T/a/
	    s/J/b/
	    s/Q/c/
	    s/K/d/
	    s/A/e/
	' .$m | \
	sort | \
	sed '
	    s/a/T/
	    s/b/J/
	    s/c/Q/
	    s/d/K/
	    s/e/A/
	' > .${m}_
    }
done

# print all distributions
[[ $rprt ]] &&
{
    [[ -f .no_ ]] && mv .no_ $out.no
    [[ -f .so_ ]] && mv .so_ $out.so
    rm -f .no .so
    exit
}

# print only distributions that score better than all weaker ones
for m in no so
do
    [[ -f .$m ]] &&
    {
	awk '
	BEGIN {
	    prevc["2"] = "1"
	    prevc["3"] = "2"
	    prevc["4"] = "3"
	    prevc["5"] = "4"
	    prevc["6"] = "5"
	    prevc["7"] = "6"
	    prevc["8"] = "7"
	    prevc["9"] = "8"
	    prevc["T"] = "9"
	    prevc["J"] = "T"
	    prevc["Q"] = "J"
	    prevc["K"] = "Q"
	    prevc["A"] = "K"
	}

	{
	    printit = 1
	    for ( l = 4; l <= NF; l += 2 )
		res[$2,l] = $l
	    for ( k = 1; k <= length($2); k++ ) {
		hit = 1
		str = substr($2,1,k-1) prevc[substr($2,k,1)] substr($2,k+1)
		for ( l = 4; l <= NF; l += 2 )
		    hit = hit && $l == res[str,l]
		if ( hit ) printit = 0
	    }
	    if ( printit ) printf "%s\n", $0
	} ' rprt=$rprt .${m}_ > $out.$m

	rm .$m .${m}_
    }
done
