#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - calculate the expected playing strength for all distributions

SYNOPSIS
    ${PGM} [-mn <mn>] [-ms <ms>] [-nn <nn>] [-ns <ns>] [-r] [-o <out>] infile

DESCRIPTION
    ${PGM} calculate the expected playing strength for all distributions

PARAMETERS
    -mn            regular expression that should be matched by north
    -ms            regular expression that should be matched by south
    -nn            regular expression that should not be matched by north
    -ns            regular expression that should not be matched by south
    -r             report=0 (default!) print only distributions that score better than all weaker ones
    -o             the output files
    infile         the input file

AUTHOR
    G.A. van der Velde
" 1>&2
    exit 22
}

# set defaults
mn="[AKQJT98765432-]"
ms="[AKQJT98765432-]"
nn="[+]"
ns="[+]"
rprt=
in=""
out=$(pwd)
out=${out##*/}

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-mn)     mn=$2; shift;;
	-ms)     ms=$2; shift;;
	-nn)     nn=$2; shift;;
	-ns)     ns=$2; shift;;
	-r)      rprt=1;;
	-o)      out="$2"; shift;;
	-mn*)    mn=${1#-mn};;
	-ms*)    ms=${1#-ms};;
	-nn*)    nn=${1#-nn};;
	-ns*)    ns=${1#-ns};;
	-o*)     out="${1#-o}";;
	-*|\? )  USAGE;;
	*)       in="$1";;
    esac
    shift
done

# # check that a correct input file is supplied
# [[ -z $in || ! -f $in  ]] && USAGE

# adjust the header
sed '
    s/N10/Na/
    s/N11/Nb/
    s/N12/Nc/
    s/N13/Nd/
' $in |\

# create the headers
nawk '
    NR == 1 {
	padn = length($2) < 8 ? "" : "\t"
	pads = length($4) < 8 ? "" : "\t"
	head1 = " #tricks"
	head2 = " ======="
	for ( i = 9; i < NF; i += 2 ) {
	    head1 = head1 "   " substr($i,2,1)
	    if ( substr($i,3,1) !~ /:/ ) head1 = head1 substr($i,3,1)
	    head1 = head1 " tricks"
	    head2 = head2 "   ========"
	}
	printf "North\t%s%s\n", padn, head1 > ".nh"
	printf "=====\t%s%s\n", padn, head2 > ".nh"
	printf "South\t%s%s\n", pads, head1 > ".sh"
	printf "=====\t%s%s\n", pads, head2 > ".sh"
    }
    $2 ~ mn && $2 !~ nn && $4 ~ ms && $4 !~ ns { printf "%s\n", $0 }
' mn=$mn ms=$ms nn=$nn ns=$ns |\

# calculate the playing strength
nawk '
{
    north[$2] = $2
    south[$4] = $4
    no[$2,0]++
    so[$4,0]++
    no[$2,2] = $2
    so[$4,4] = $4
    for ( i = 8; i <= NF; i += 2 )
    {
	no[$2,i] += $i
	so[$4,i] += $i
    }
}
END {
    for ( m in north ) {
	printf "%s	%8.4f", no[m,2], no[m,8] / no[m,0] > ".no"
	for ( i = 10; i <= NF; i += 2 )
	    printf "   %8.4f", no[m,i] / no[m,0] > ".no"
	printf "\n" > ".no"
    }

    for ( m in south ) {
	printf "%s	%8.4f", so[m,4], so[m,8] / so[m,0] > ".so"
	for ( i = 10; i <= NF; i += 2 )
	    printf "   %8.4f", so[m,i] / so[m,0] > ".so"
	printf "\n" > ".so"
    }
} '

# order the output
for m in no so
do
    [[ -f .$m ]] &&
    {
	sed '
	    s/T/a/
	    s/J/b/
	    s/Q/c/
	    s/K/d/
	    s/A/e/
	' .$m | \
	sort | \
	sed '
	    s/a/T/
	    s/b/J/
	    s/c/Q/
	    s/d/K/
	    s/e/A/
	' > .${m}_
    }
done

# copy the adjusted headers
for m in n s
do
    sed '
	s/1 tricks/ 1 trick/
	s/ a tricks/10 tricks/
	s/ b tricks/11 tricks/
	s/ c tricks/12 tricks/
	s/ d tricks/13 tricks/
    ' .${m}h > $out.${m}o
done

# print all distributions
sed 's/1 tricks/ 1 trick/' .nh > $out.no
sed 's/1 tricks/ 1 trick/' .sh > $out.so
[[ $rprt ]] &&
{
    cat .no_ >> $out.no
    cat .so_ >> $out.so
    rm .[ns][ho]*
    exit
}

# print only distributions that score better than all weaker ones
for m in no so
do
    [[ -f .$m ]] &&
    nawk '
    BEGIN {
	prevc["2"] = "1"
	prevc["3"] = "2"
	prevc["4"] = "3"
	prevc["5"] = "4"
	prevc["6"] = "5"
	prevc["7"] = "6"
	prevc["8"] = "7"
	prevc["9"] = "8"
	prevc["T"] = "9"
	prevc["J"] = "T"
	prevc["Q"] = "J"
	prevc["K"] = "Q"
	prevc["A"] = "K"
    }

    {
	printit = 1
	for ( l = 2; l <= NF; l++ )
	    res[$1,l] = $l
	for ( k = 1; k <= length($1); k++ ) {
	    hit = 1
	    str = substr($1,1,k-1) prevc[substr($1,k,1)] substr($1,k+1)
	    for ( l = 2; l <= NF; l++ )
		hit = hit && $l == res[str,l]
	    if ( hit ) printit = 0
	}
	if ( printit || NR == 1 ) printf "%s\n", $0
    } ' rprt=$rprt .${m}_ >> $out.${m}
done

rm .[ns][ho]*
