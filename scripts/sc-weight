#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - calculate the expected number of tricks

SYNOPSIS
    ${PGM} [-D] [-f] [-h honors] [-m ms] [-n ns] [-p points] [-o out] infile

DESCRIPTION
    ${PGM} calculates the expected number of tricks for the different
    holdings of south. The expected number of tricks depends on the
    number of HCP points in north in the analysed suit (the -p option) and
    the high cards in south in the non-analysed suits (the -h option). Ĩf
    the south hand contains more honors in the non-analysed suit the
    strength of the north hand shifts from the non-analysed suits to the
    analysed suit. For a fair comparison the total strength of the south
    hand should remain the same. So it is fair to compare the results of
	sc-tricks -h KQQ -m Q ...
    with
	sc-tricks -h KQQQ ...

PARAMETERS
    -D        print debug information
    -f        print a full report with all holdings
    honors    the honors in south in the other suits, e.g KKQ
    ms        regular expression that should be matched by south
    ns        regular expression that should not be matched by south
    points    the range of HCP in north
    out       the output files
    infile    the input file. this file sould be a ??.xp file generated by the sc-expand command

AUTHOR
    G.A. van der Velde
" 1>&2
    exit 22
}

# set defaults
debug=0
fullreport=
honors="KQQ"
points=8
ms=[AKQJT98765432-]{1}
ns=[x]
in=
out=$(pwd)
out=${out##*/}
debug=0

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-D)        debug=1;;
	-f)        fullreport=1;;
	-h)        honors=$2; shift;;
	-m)        ms=$2; shift;;
	-n)        ns=$2; shift;;
	-p)        points=$2; shift;;
	-o)        out="$2"; shift;;
	-h*)       honors=${1#-h};;
	-m*)       ms=${1#-m};;
	-n*)       ns=${1#-n};;
	-p*)       points=${1#-p};;
	-o*)       out="${1#-o}";;
	-*|\?)     USAGE;;
	*)         in="$1";;
    esac
    shift
done

# adjust the header
sed '
    s/N10/Na/
    s/N11/Nb/
    s/N12/Nc/
    s/N13/Nd/
' $in |\

nawk '
BEGIN {
    bin[0,0] = 1; for ( i = 1; i <= 4; i++ ) { bin[i,0] = 1; for ( j = 1; j <= i; j++ ) bin[i,j] = bin[i,j-1] * (i+1-j) / j }
    c[0] = "x"; c[1] = "J"; c[2] = "Q"; c[3] = "K"; c[4] = "A"
    North[01] = "[AKQJ]{4}";    hcp[01] =10
    North[02] = "[AKQ]{3}";     hcp[02] = 9
    North[03] = "[AKJ]{3}";     hcp[03] = 8
    North[04] = "[AK]{2}";      hcp[04] = 7
    North[05] = "[AQJ]{3}";     hcp[05] = 7
    North[06] = "[AQ]{2}";      hcp[06] = 6
    North[07] = "[AJ]{2}";      hcp[07] = 5
    North[08] = "[A]{1}";       hcp[08] = 4
    North[09] = "[KQJ]{3}";     hcp[09] = 6
    North[10] = "[KQ]{2}";      hcp[10] = 5
    North[11] = "[KJ]{2}";      hcp[11] = 4
    North[12] = "[K]{1}";       hcp[12] = 3
    North[13] = "[QJ]{2}";      hcp[13] = 3
    North[14] = "[Q]{1}";       hcp[14] = 2
    North[15] = "[J]{1}";       hcp[15] = 1
    North[16] = "[T98765432-]"; hcp[16] = 0
    len = 16
}
{
    # determine the HCP limits
    if ( NR == 1 ) {
	lpoints = index(points,"-") ? substr(points,1,index(points,"-")-1) : points
	hpoints = index(points,"-") ? substr(points,index(points,"-")+1) : points
    }

    # create the headers
    if ( NR == 1 ) {
	printf "\n%d-%d distribution, North has %d-%d HCP, South has %s in the other suits\n\n", length($2), length($4), lpoints, hpoints, honors > ".hh"
	padn = length($2) < 8 ? "" : "\t"
	pads = length($4) < 8 ? "" : "\t"
	head1 = " #tricks"
	head2 = " ======="
	for ( i = 9; i < NF; i += 2 ) {
	    head1 = head1 "   " substr($i,2,1)
	    if ( substr($i,3,1) !~ /:/ ) head1 = head1 substr($i,3,1)
	    head1 = head1 " tricks"
	    head2 = head2 "   ========"
	}
	printf "North\t%s%s\n", padn, head1 > ".nh"
	printf "=====\t%s%s\n", padn, head2 > ".nh"
	printf "South\t%s%s\n", pads, head1 > ".sh"
	printf "=====\t%s%s\n", pads, head2 > ".sh"
    }

    # translate the parameters into regular expressions
    if ( NR == 1 ) {
	ms = index(ms,"[") || index(ms,"{") ? ms : "[" ms "]{" sprintf("%d",length(ms)) "}"
	ns = index(ns,"[") || index(ns,"{") ? ns : "[" ns "]"
    }

    # create a list of possible spade holdings in North and calculate the weight factors
    if ( NR == 1 ) {

	# print the parameters
	if ( debug ) {
	    printf "HCP north     :    %d-%d\n", lpoints, hpoints
	    printf "honors south  :    %s\n", honors
	}

	# calculate the number of honors in hearts, diamonds and clubs in north, east and west combined
	# 	spades		aces		kings		queens		jacks		small
	# S	$4		#A		#K		#Q		#J		(13-$4-#A-#K-#Q-#J)
	# N	$2		#a		#k		#q		#j		(13-$2-#a-#k-#q-#j)
	# WE	(13-$2-$4)	(3-#A-#a)	(3-#K-#k)	(3-#Q-#q)	(3-#J-#j)	(1+$2+$4+#A+#a+#K+#k+#Q+#q+#J+#j)
	# WNE	(13-$4)		(3-#A)		(3-#K)		(3-#Q)		(3-#J)		(14+$4+#A+#K+#Q+#J)
	ncards[0] = 14 + length($4)
	for ( i = 1; i <= 4; i++ )
	    ncards[i] = 3
	for ( j = 1; j <= length(honors); j++ ) {
	    for ( i = 1; i <= 4; i++ ) {
		if ( c[i] ~ substr(honors,j,1) ) {
		    ncards[i]--
		    ncards[0]++
		}
	    }
	}

	bin[ncards[0],0] = 1
	for ( j = 1; j <= ncards[0]; j++ )
	    bin[ncards[0],j] = bin[ncards[0],j-1] * ( ncards[0] + 1 - j ) / j
	if ( debug ) {
	    printf "#honnours WNE :  "
	    for ( i = 4; i >= 0; i-- )
		printf "  %s=%d", c[i], ncards[i];
	    printf "\n"
	}

	# calculate the weight factors
	for ( l = 1; l <= len; l++ ) {

	    # initialise
	    weight[l] = 0
	    if ( debug ) printf "%-12s       hcp=%02d\n", North[l], hcp[l]

	    # calculate the weight factor
	    for ( k[4] = ncards[4]; k[4] >= 0; k[4]-- ) {
		if ( 4*k[4] > hpoints - hcp[l] ) continue;
		for ( k[3] = ncards[3]; k[3] >= 0; k[3]-- ) {
		    if ( 4*k[4] + 3*k[3] > hpoints - hcp[l] ) continue;
		    for ( k[2] = ncards[2]; k[2] >= 0; k[2]-- ) {
			if ( 4*k[4] + 3*k[3] + 2*k[2] > hpoints - hcp[l] ) continue;
			for ( k[1] = ncards[1]; k[1] >= 0; k[1]-- ) {
			    if ( 4*k[4] + 3*k[3] + 2*k[2] + k[1] < lpoints - hcp[l] ||
				 4*k[4] + 3*k[3] + 2*k[2] + k[1] > hpoints - hcp[l] ) continue;
			    k[0] = ncards[0] - k[1] - k[2] - k[3] - k[4]
			    w = 1
			    for ( i = 0; i <= 4; i++ )
				w *= bin[ncards[i],k[i]]
			    weight[l] += w
			    if ( debug ) {
				for ( j = 4; j >= 1; j-- )
				    printf "%s=%x ", c[j], k[j];
				printf "   hcp=%02d    w=%6d    weight[l]=%7d\n", 4*k[4] + 3*k[3] + 2*k[2] + k[1], w, weight[l]
			    }
			}
		    }
		}
	    }
	}
    }

    # store the playing strengths
    if ( $4 ~ ms && $4 !~ ns ) {
	for ( l = 1; l <= len; l++ ) {
	    if ( $2 ~ North[l] ) {
		if ( weight[l] ) {
		    # if ( debug ) printf "l=%02d    %-16s    weight=%7d    %s\n", l, North[l], weight[l], $0
		    north[$2] = $2
		    south[$4] = $4
		    no[$2,0] += weight[l]
		    so[$4,0] += weight[l]
		    no[$2,2] = $2
		    so[$4,4] = $4
		    for ( i = 8; i <= NF; i += 2 )
		    {
			no[$2,i] += weight[l] * $i
			so[$4,i] += weight[l] * $i
		    }
		}
		break;
	    }
	}
    }
}
END {
    for ( m in north ) {
	if ( no[m,0] ) {
	    printf "%s\t%8.4f", no[m,2], no[m,8] / no[m,0] > ".no"
	    for ( i = 10; i <= NF; i += 2 )
		printf "   %8.4f", no[m,i] / no[m,0] > ".no"
	    printf "\n" > ".no"
	}
    }

    for ( m in south ) {
	if ( so[m,0] ) {
	    printf "%s\t%8.4f", so[m,4], so[m,8] / so[m,0] > ".so"
	    for ( i = 10; i <= NF; i += 2 )
		printf "   %8.4f", so[m,i] / so[m,0] > ".so"
	    printf "\n" > ".so"
	}
    }
} ' debug=$debug honors=$honors ms=$ms ns=$ns points=$points out=$out

# order the output
for m in no so
do
    [[ -f .$m ]] &&
    {
	sed '
	    s/T/a/
	    s/J/b/
	    s/Q/c/
	    s/K/d/
	    s/A/e/
	' .$m | \
	sort | \
	sed '
	    s/a/T/
	    s/b/J/
	    s/c/Q/
	    s/d/K/
	    s/e/A/
	' > .${m}_
    }
done

# copy the adjusted headers
for m in n s
do
    sed '
	s/1 tricks/ 1 trick/
	s/ a tricks/10 tricks/
	s/ b tricks/11 tricks/
	s/ c tricks/12 tricks/
	s/ d tricks/13 tricks/
    ' .${m}h > $out.${m}o
done

# print all distributions
sed 's/1 tricks/ 1 trick/' .hh .nh > $out.no
sed 's/1 tricks/ 1 trick/' .hh .sh > $out.so
[[ $fullreport ]] &&
{
    cat .no_ >> $out.no
    cat .so_ >> $out.so
    rm .[hns][ho]*
    exit
}

# print only distributions that score better than all weaker ones
for m in no so
do
    [[ -f .$m ]] &&
    nawk '
    BEGIN {
	prevc["2"] = "1"
	prevc["3"] = "2"
	prevc["4"] = "3"
	prevc["5"] = "4"
	prevc["6"] = "5"
	prevc["7"] = "6"
	prevc["8"] = "7"
	prevc["9"] = "8"
	prevc["T"] = "9"
	prevc["J"] = "T"
	prevc["Q"] = "J"
	prevc["K"] = "Q"
	prevc["A"] = "K"
    }

    {
	printit = 1
	for ( l = 2; l <= NF; l++ )
	    res[$1,l] = $l
	for ( k = 1; k <= length($1); k++ ) {
	    hit = 1
	    str = substr($1,1,k-1) prevc[substr($1,k,1)] substr($1,k+1)
	    for ( l = 2; l <= NF; l++ )
		hit = hit && $l == res[str,l]
	    if ( hit ) printit = 0
	}
	if ( printit || NR == 1 ) printf "%s\n", $0
    } ' .${m}_ >> $out.${m}
done

rm .[nhs][ho]*
