#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - install SuitC commands for all distributions

SYNOPSIS
    ${PGM} [-M] c

DESCRIPTION
    ${PGM} installs SuitC commands for all distributions. The commands
    for each distribution are installed in its own subdirectory.

PARAMETERS
    -M    add the '-M' option to all commands
    c     The value of the '-c' parameter. allowed values are 020k,
	  040k, 100k, 200k, 400k, 001M, 002M, 004M, 010M, 020M, 040M, 100M,
	  200M, 400M, 001G, 002G and 001T

AUTHOR
    G.A. van der Velde, Leiden
" 1>&2
    exit 22
}

# set defaults
c=
M="  "

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-M)      M="-M";;
	-*|\? )  USAGE;;
	*)       c="$1";;
    esac
    shift
done

# generate a file with all distributions
playc > 1

echo "" | \
awk ' BEGIN {
    for ( i = 0; i <= 13; i++ ) {
	for ( j = 0; j <= 13-i; j++ ) {
	    printf "[[ -a %x%x ]] || mkdir %x%x; grep =^", i, j, i, j
	    if ( i == 0 )
		printf "\\."
	    else if ( i == 1 )
		printf "[^\\.]"
	    else
		for ( k = 0; k < i; k++ )
		    printf "."
	    printf " "
	    if ( j == 0 )
		printf "\\."
	    else if ( j == 1 )
		printf "[^\\.]"
	    else
		for ( k = 0; k < j; k++ )
		    printf "."
	    printf " = 1 > %x%x/%x%x\n", i, j, i, j
	}
    }
    exit
} ' | \
sed "s/=/'/g" > 2

# create the skeleton command files
. ./2

# cleanup
rm 1 2

# create the command files
for m in 00 01 10 02 11 20 03 12 21 30 04 13 22 31 40 05 14 23 32 41 50 06 15 24 33 42 51 60 07 16 25 34 43 52 61 70 08 17 26 35 44 53 62 71 80 09 18 27 36 45 54 63 72 81 90 0a 19 28 37 46 55 64 73 82 91 a0 0b 1a 29 38 47 56 65 74 83 92 a1 b0 0c 1b 2a 39 48 57 66 75 84 93 a2 b1 c0 0d 1c 2b 3a 49 58 67 76 85 94 a3 b2 c1 d0
do
    [[ -a $m/plays ]] || mkdir $m/plays
    awk ' { printf "%s> out; cp -f out plays/%s.%s\n", $0, $1, $2 } ' $m/$m | \
    sed "
	s+a+T+
	s+b+J+
	s+c+Q+
	s+d+K+
	s+e+A+
	s+/\.\.+/0.+
	s+\.\.+.0+
	s+^+SuitC -T1        $M +
    " > x_
    mv x_ $m/$m
done

# replace the '-M' parameter by '-r' for selected distributions

# 05
sed '
    /0.db975/s/T1        ../T1        -r/
' 05/05 > x_
mv x_ 05/05

# 50
sed '
    /db975.0/s/T1        ../T1        -r/
' 50/50 > x_
mv x_ 50/50

# add '-M' parameters

if [[ $M = "  " ]] then

    # 04
    sed '
	/0.db97/s/T1          /T1        -M/
    ' 04/04 > x_
    mv x_ 04/04

    # 40
