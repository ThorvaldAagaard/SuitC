#!/bin/bash

PGM=${0##*/}

USAGE() {
    printf "
NAME
    ${PGM} - report selected information from the SuitC output

SYNOPSIS
    ${PGM} [-a] [-b] [-p] files

DESCRIPTION
    ${PGM} reports selected information from the SuitC output. The
    selected output consists of:
    i)       the distribution
    ii)      the optimum play for N? and MAX
    iii)     the optimum results
    the boards are printed only if the game tree is printed

PARAMETERS
    -a       print all plays
    -b       print the east-west distributions
    -p       print the game tree
    files    the input files. these files are output files of script v-equals

AUTHOR
    G.A. van der Velde, Leiden
" 1>&2
    exit 1
}

# set defaults
all=0
boards=0
plays=0
fil=

# process the parameters of the command
while [[ -n "$1" ]]
do
    case $1 in
	-a)      all=1;;
	-b)      boards=1;;
	-p)      plays=1;;
	-*|\? )  USAGE;;
	*)       fil="$fil $1";;
    esac
    shift
done

# generate the report
awk '

$1 ~ /[Nn]orth:/ {
    n = split( FILENAME, arr, "/" )
    tab = length( arr[n] ) < 8 ? 1 : 0
    printf "N: %s", $2
    getline
    printf "   S: %s", $2
    getline
    printf "   EW: %s\t", $3
    N = 0
}

$2 ~ /optimum/ && NF > 4 {
    res[N] = substr( $0, 23 )
    for ( i = 0; i <= N; i++ )
	if ( res[i] == res[N] )
	    break
    if ( i == N || all ) {
	if ( N )
	    printf "\t\t\t\t"
	printf "\t%s\t\t", res[N]
	if ( length( $0 ) < 30 )
	    printf "\t"
	head2 = ""
	getline; getline; getline
	if ( $2 ~ /tricks:/ ) {
	    head2 = head2 sprintf( "N%d =%6.2f   ", $1, $3 )
	    getline
	    while( $2 ~ /tricks:/ ) {
		head2 = head2 sprintf( "N%d =%6.2f   ", $1, $3 )
		getline
	    }
	}
	head2 = head2 sprintf( " R = %5.2f", $3 )
	printf "%s\n", head2
	if ( pp ) {
	    printf "\n"
	    getline; if ( $1 ~ /MP-score/ ) getline; getline
	    if ( NF ) {
		while ( $0 !~ /[ne][sw]/ ) {
		    if ( pb )
			printf "\t%s\n", $0
		    getline
		}
		while ( $0  ~ /[ne][sw]/ ) {
		    if ( pb )
			printf "\t%s\n", $0
		    else
			printf "\t%s\n", substr( $0, 1, match( $0, / *[ne][sw]=/ ) - 1 )
		    getline
		}
		printf "\n"
	    }
	}
	N++
    }
}
$4 ~ /finished/ {
    printf "\n\n\n"
} ' all=$all pb=$boards pp=$plays $fil
